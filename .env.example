# Sawt al-Tameen configuration.  cp .env.example .env  then fill in the section for the mode you want.
# .env is git-ignored. Never commit real values.
#
#   Local mode:   ./scripts/run_local.sh     needs nothing below except, for speech, the voice path
#   Hosted mode:  ./scripts/run_hosted.sh    needs "HOSTED MODE — required" plus ONE tunnel provider
#
# Values the hosted script generates for itself (the voice-tool token, the gateway secret and the webhook signing
# secret) are written to .hosted/secrets.env, not here, so local mode never sees them.


# =============================================================================================================
# LOCAL MODE (no credentials needed)
# =============================================================================================================
# Everything has a working default. Full reference: docs/LOCAL_MODE.md

# Path to a Piper voice (.onnx; its .onnx.json must sit beside it). Download once with:
#   uv run python -m piper.download_voices en_GB-alba-medium --data-dir ./models/piper
PREAUTH_LOCAL_TTS_VOICE=./models/piper/en_GB-alba-medium.onnx
# Any tool-calling model you have pulled with `ollama pull`.
PREAUTH_LOCAL_LLM_MODEL=qwen2.5-coder:7b
# First port tried; if it is busy, run_local.sh moves up to the next free one and prints which it used.
PREAUTH_LOCAL_PORT=8000
# Optional (defaults shown): PREAUTH_LOCAL_LLM_BASE_URL=http://localhost:11434  PREAUTH_LOCAL_LLM_TIMEOUT_SECONDS=120
# PREAUTH_LOCAL_LLM_CONTEXT_TOKENS=8192  PREAUTH_LOCAL_STT_MODEL=small  PREAUTH_LOCAL_STT_PROVIDER=faster-whisper
# PREAUTH_LOCAL_TTS_PROVIDER=piper  (set either provider to "none" on a machine without a microphone/speakers)


# =============================================================================================================
# HOSTED MODE — required
# =============================================================================================================

# Migration switch. Keep `elevenlabs` for rollback until live AssemblyAI validation is signed off.
VOICE_PROVIDER=elevenlabs

# ElevenLabs → Developers → API keys (https://elevenlabs.io/app/settings/api-keys) → Create API key.
# If you restrict its scopes, allow ElevenAgents (read + write) and Workspace webhooks.
ELEVENLABS_API_KEY=

# AssemblyAI hosted mode (required when VOICE_PROVIDER=assemblyai). Run `python scripts/assemblyai_setup.py`
# after selecting an English voice to create/update the two stored agents.
ASSEMBLYAI_API_KEY=
PREAUTH_ASSEMBLYAI_VOICE_ID=
PREAUTH_ASSEMBLYAI_BROWSER_AGENT_ID=
PREAUTH_ASSEMBLYAI_PHONE_AGENT_ID=
# Use independent random values; never reuse an API key. The webhook verifies completed-session events, while the
# media secret signs the short-lived WebSocket URL handed to Twilio.
PREAUTH_ASSEMBLYAI_WEBHOOK_SECRET=
PREAUTH_ASSEMBLYAI_MEDIA_SECRET=


# =============================================================================================================
# HOSTED MODE — tunnel (pick ONE provider)
# =============================================================================================================
# The tunnel gives this machine a public https:// address that stays the same on every run, so the ElevenLabs
# tools and webhook keep pointing at the right place. Fill in ONE of the two options below.
#
# Which one is used: PREAUTH_TUNNEL_PROVIDER if set; otherwise whichever has credentials filled in (ngrok first
# if both do). If neither is filled in, run_hosted.sh stops and says so.
PREAUTH_TUNNEL_PROVIDER=

# ---- Option A: ngrok (recommended — free, NO domain purchase needed) -----------------------------------------
# The free plan includes one static domain, so the URL never changes. Install the agent: https://ngrok.com/download

# dashboard.ngrok.com/get-started/your-authtoken → copy "Your Authtoken".
NGROK_AUTHTOKEN=
# dashboard.ngrok.com/domains → claim your free static domain → paste the hostname only,
# e.g. sawt-al-tameen.ngrok-free.app (no https://). This becomes the public URL; PREAUTH_PUBLIC_BASE_URL is not used.
NGROK_STATIC_DOMAIN=

# ---- Option B: Cloudflare named tunnel (needs a domain you own, added to Cloudflare) --------------------------
# Cloudflare dashboard → Networking → Tunnels → your tunnel → the long token in the install command
# ("cloudflared service install <TOKEN>"). Created once; see ONE-TIME SETUP (Cloudflare) below.
CLOUDFLARE_TUNNEL_TOKEN=
# The https:// hostname you published on that tunnel, e.g. https://preauth.example.com
PREAUTH_PUBLIC_BASE_URL=


# =============================================================================================================
# HOSTED MODE — optional, only needed for real phone calls (web test-call works without these)
# =============================================================================================================
# Calls to your Twilio number are posted by Twilio to this backend (/api/v1/voice/twilio/inbound), which registers
# each one with the ElevenLabs agent (register-call). ElevenLabs' native number import is not used.

# Twilio Console (https://console.twilio.com) → Account Info panel → Auth Token → Show.
# Required for phone calls: the backend uses it to verify every request really comes from Twilio.
TWILIO_AUTH_TOKEN=
# Twilio Console → Phone Numbers → Manage → Active numbers. International format, e.g. +14155550123.
# Only shown in the summary; the Twilio side is one console setting (see ONE-TIME SETUP → Phone calling).
TWILIO_PHONE_NUMBER=
# Same Account Info panel → Account SID (starts AC). Not needed by register-call; kept for reference.
TWILIO_ACCOUNT_SID=


# =============================================================================================================
# HOSTED MODE — advanced (leave blank unless you have a reason)
# =============================================================================================================

# Local port the backend listens on. ngrok follows it automatically; for Cloudflare it must equal the port in the
# tunnel's Service URL (http://localhost:8000).
PREAUTH_HOSTED_PORT=8000
# SQLite by default; a postgres:// URL (e.g. Neon free tier) also works.
PREAUTH_DATABASE_URL=sqlite:///./preauth.db
# The ElevenLabs agent inbound Twilio calls are registered with. run_hosted.sh fills it in from
# .elevenlabs-state.json; set it only when running the backend some other way.
PREAUTH_ELEVENLABS_AGENT_ID=
# Generated automatically into .hosted/secrets.env when blank. Set them here only to pin your own values.
PREAUTH_VOICE_AGENT_TOKEN=
PREAUTH_GATEWAY_SECRET=
PREAUTH_ELEVENLABS_WEBHOOK_SECRET=


# =============================================================================================================
# ONE-TIME SETUP for hosted mode (do these once; after that, only ./scripts/run_hosted.sh)
# =============================================================================================================
#
# ---- If you chose ngrok (Option A) — no domain, no cost --------------------------------------------------------
#
# 1. Sign up at https://dashboard.ngrok.com/signup (free).
# 2. Install the agent: https://ngrok.com/download  (the script runs it; you never start it yourself).
# 3. Copy your authtoken from https://dashboard.ngrok.com/get-started/your-authtoken into NGROK_AUTHTOKEN.
# 4. Claim your free static domain at https://dashboard.ngrok.com/domains and put it in NGROK_STATIC_DOMAIN.
#
# That is all. Free-plan limits worth knowing: one agent online at a time, and a monthly traffic allowance that
# a demonstration will not approach. Browsers visiting the URL see a one-time ngrok notice page; ElevenLabs'
# server-to-server calls do not.
#
# ---- If you chose Cloudflare (Option B) ------------------------------------------------------------------------
#
# 1. A domain on Cloudflare. A named tunnel publishes on a hostname in a domain you have added to Cloudflare
#    (https://dash.cloudflare.com → Add a domain). This is the one part of hosted mode that is not free if you
#    do not already own a domain. Without one, the only Cloudflare option is a quick tunnel, whose URL changes
#    every run — which would break the ElevenLabs tools and webhook on each restart.
#
# 2. Create the tunnel: Cloudflare dashboard → Networking → Tunnels → Create a tunnel → Cloudflared → name it
#    (e.g. sawt-al-tameen) → on the "Install connector" page, copy the token from the command shown and paste
#    it into CLOUDFLARE_TUNNEL_TOKEN above. You do NOT need to run that install command; the script runs
#    cloudflared itself.
#
# 3. Publish the backend on it: same tunnel → Published application routes (older dashboards: Public
#    Hostnames) → Add → Subdomain e.g. "preauth", Domain = your domain, Service Type HTTP, URL localhost:8000
#    (must match PREAUTH_HOSTED_PORT) → Save. Put https://<subdomain>.<domain> in PREAUTH_PUBLIC_BASE_URL.
#
# 4. Install cloudflared on this machine:
#    https://developers.cloudflare.com/cloudflare-one/networks/connectors/cloudflare-tunnel/downloads/
#
# Phone calling (optional), using your own Twilio number:
#   1. Sign up at https://www.twilio.com/try-twilio and buy a voice-capable number (Phone Numbers → Buy a number).
#   2. Put TWILIO_AUTH_TOKEN (and TWILIO_PHONE_NUMBER) in .env.
#   3. Twilio Console → Phone Numbers → Manage → Active numbers → your number → Voice Configuration →
#      "A call comes in": Webhook, URL = <your public URL>/api/v1/voice/twilio/inbound, HTTP = POST → Save.
#      run_hosted.sh prints this exact URL at the end of every run.
#   Trial accounts only accept calls from numbers you have verified in Twilio, and play a trial notice first.
